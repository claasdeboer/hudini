{
  "_description": "Da Vinci Xi pod strings — instrument names and system messages as they appear in the surgical UI. Stored lowercase; UI rendering should apply .title() (or similar) at display boundaries. Loading expands each entry into its aliases — the string forms it can be found under (canonical name, localized name, reload-color variants). Aliases are derived at load time and are not stored here.",
  "_schema": {
    "entries[i].name": "Canonical English UI name (required). Lowercase; how the instrument appears in the da Vinci surgeon-console UI.",
    "entries[i].type": "Required. Taxonomy of the pod string (snake_case). For instruments it is the clinical/functional class — e.g. bipolar_grasper, needle_driver, stapler ('what does this tool do?'); non-instrument pod strings use system_message.",
    "entries[i].localized": "Optional. {locale: name} for entries whose UI display is locale-specific (e.g. system messages rendered in German).",
    "entries[i].reload_colors": "Optional. List of English color codes; expanded to 'name [color_locales[locale][c]]' at load time. Only present on stapler entries that have reload variants.",
    "entries[i].pedals": "Optional. Per-pedal labels seen in the UI for this instrument, stored lowercase like other catalog strings. Shape: {yellow: [labels...], blue: [labels...]}. Each list is the labels that can appear on that pedal across instrument states, ORDERED WITH THE IDLE LABEL FIRST — what the pod shows while the pedal is not pressed. Multiple labels indicate state-dependent behavior (e.g. force bipolar yellow reads 'grip' idle and 'strong' held), and the reader only OCRs the label while a pedal is pressed, taking the idle one from here. An empty list means that pedal has no action for this instrument (e.g. maryland bipolar has no yellow pedal). Omitting the whole `pedals` field means unknown — do not infer from type, since some mechanical instruments may still have pedal actions."
  },
  "color_locales": {
    "de": {
      "gray": "grau",
      "white": "weiss",
      "blue": "blau",
      "green": "grün",
      "black": "schwarz"
    },
    "en": {
      "gray": "gray",
      "white": "white",
      "blue": "blue",
      "green": "green",
      "black": "black"
    }
  },
